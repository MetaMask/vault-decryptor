{
  "name": "@rabby-wallet/vault-decryptor",
  "version": "2.0.0",
  "private": true,
  "description": "Recover seed phrases and private keys from Rabby (and MetaMask) extension vault data",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "author": "Dan Finlay",
  "license": "ISC",
  "dependencies": {
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "rollup": "4.27.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  },
  "keywords": [
    "rabby",
    "metamask",
    "vault-decryptor",
    "ethereum wallet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RabbyHub/vault-decryptor.git"
  },
  "bugs": {
    "url": "https://github.com/RabbyHub/vault-decryptor/issues"
  },
  "homepage": "https://github.com/RabbyHub/vault-decryptor#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@3.4.1"
}
